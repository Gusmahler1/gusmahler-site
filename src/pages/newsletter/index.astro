---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubscribeForm from '../../components/SubscribeForm.astro';

const issues = (await getCollection('issues')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout
  title="Newsletter Archive — Prediction Markets Weekly"
  description="Every issue of Prediction Markets Weekly, a weekly briefing on the regulatory battle over U.S. prediction markets."
>
  <div class="prose-issue py-10">
    <h1 class="text-3xl font-serif mb-2 mt-0">Prediction Markets Weekly</h1>
    <p class="font-sans text-[var(--color-muted)] text-sm mb-8">
      A weekly briefing on the regulatory battle over U.S. prediction markets. {issues.length} issues published.
    </p>

    <SubscribeForm />

    <h2 class="section-heading">Archive</h2>
    <ul class="issue-list">
      {issues.map((issue) => {
        const displayDate = issue.data.date.toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
          timeZone: 'UTC',
        });
        return (
          <li>
            <a href={`/newsletter/${issue.slug}`} class="issue-link">
              <span class="issue-date font-sans text-sm text-[var(--color-muted)]">{displayDate}</span>
              <span class="issue-title">{issue.data.title}</span>
              {issue.data.preview && (
                <span class="issue-preview font-sans text-sm text-[var(--color-muted)]">
                  {issue.data.preview}
                </span>
              )}
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</BaseLayout>

<style>
  .section-heading {
    font-size: 1.05rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #444;
    margin-top: 40px;
    margin-bottom: 16px;
    border-bottom: 1px solid #ddd;
    padding-bottom: 4px;
    font-family: -apple-system, 'Helvetica Neue', sans-serif;
  }

  .issue-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .issue-list li {
    border-bottom: 1px solid #f0f0f0;
  }

  .issue-list li:last-child {
    border-bottom: none;
  }

  .issue-link {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 14px 0;
    text-decoration: none;
    color: inherit;
  }

  .issue-link:hover .issue-title {
    text-decoration: underline;
  }

  .issue-title {
    font-size: 1rem;
    font-weight: bold;
    color: #1a1a1a;
  }

  .issue-preview {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
