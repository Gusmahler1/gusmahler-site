---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const allIssues = await getCollection('issues');

// Sort ascending to assign issue numbers (oldest = issue 01)
const issuesByDateAsc = [...allIssues].sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
const issueNumberMap = new Map(issuesByDateAsc.map((issue, idx) => [issue.id, idx + 1]));

// Sort descending for display (latest first)
const issues = [...allIssues].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latest = issues[0];
const latestNum = latest ? (issueNumberMap.get(latest.id) ?? 1) : 1;
---

<BaseLayout
  title="Prediction Markets Weekly — Newsletter"
  description="A weekly newsletter covering CFTC rulemaking, congressional activity, state enforcement, and company news in the prediction markets industry."
>
  <article class="nl">

    <header>
      <div class="kicker-bold">Prediction Markets Weekly · By Gus Mahler · Since February 2026</div>
      <h1 class="nl__hl">The Regulatory Battle.</h1>
      <p class="nl__deck">A weekly newsletter covering CFTC rulemaking, congressional activity, state enforcement, and company news in the prediction markets industry. One edition every Monday. Free.</p>
      <div class="nl__sub">
        <p class="nl__ok">Subscribe. Email pipeline coming in Phase 2.</p>
      </div>
    </header>

    <hr class="rule-hard" />

    {latest && (
      <section class="nl__current">
        <div class="ribbon">Latest Edition · Issue {String(latestNum).padStart(2, '0')}</div>
        <hr class="rule" />
        <div class="nl__current-grid">
          <div>
            <div class="kicker">
              {latest.data.date.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
                timeZone: 'UTC',
              })}
            </div>
            <h2 class="nl__current-hl">{latest.data.headline ?? latest.data.title}</h2>
            {latest.data.preview && <p class="nl__current-deck">{latest.data.preview}</p>}
            <a class="btn" href={`/newsletter/${latest.id}`}>Read Issue {String(latestNum).padStart(2, '0')} →</a>
          </div>
          <aside class="nl__glance">
            <div class="kicker-bold">This Week at a Glance</div>
            <ul>
              {latest.data.glance.map((item, i) => (
                <li>
                  <span class="nl__glance-num">{String(i + 1).padStart(2, '0')}</span>
                  <span>{item.split('.')[0]}.</span>
                </li>
              ))}
            </ul>
          </aside>
        </div>
      </section>
    )}

    <section class="nl__archive">
      <div class="ribbon">The Archive</div>
      <hr class="rule-hard" />
      <ol class="nl__list">
        {issues.map((issue) => {
          const num = issueNumberMap.get(issue.id) ?? 1;
          const displayDate = issue.data.date.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
            timeZone: 'UTC',
          });
          return (
            <li class="nl__row">
              <a class="nl__link" href={`/newsletter/${issue.id}`}>
                <div class="nl__num">{String(num).padStart(2, '0')}</div>
                <div>
                  <div class="kicker">{displayDate}</div>
                  <h3 class="nl__title">{issue.data.headline ?? issue.data.title}</h3>
                  {issue.data.preview && <p class="nl__row-deck">{issue.data.preview}</p>}
                </div>
                <div class="nl__read">Read →</div>
              </a>
            </li>
          );
        })}
      </ol>
    </section>

  </article>
</BaseLayout>
