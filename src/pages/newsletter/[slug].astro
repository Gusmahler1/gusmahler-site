---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GlanceList from '../../components/GlanceList.astro';
import ScorecardTable from '../../components/ScorecardTable.astro';
import ImplicationBox from '../../components/ImplicationBox.astro';

export async function getStaticPaths() {
  const issues = await getCollection('issues');
  return issues.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const displayDate = entry.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<BaseLayout
  title={entry.data.subject ?? entry.data.title}
  description={entry.data.preview ?? `Prediction Markets Weekly — ${displayDate}`}
>
  <article class="ed">

    <div class="essay__back-wrap">
      <a class="back" href="/newsletter">← All editions</a>
    </div>

    <hr class="rule-hard" />

    <div class="ed__kicker">{displayDate} · By Gus Mahler</div>
    <h1 class="ed__hl">{entry.data.headline ?? entry.data.title}</h1>
    {entry.data.preview && <p class="ed__deck">{entry.data.preview}</p>}

    <hr class="rule" />

    {entry.data.glance.length > 0 && (
      <section class="ed__section">
        <div class="ribbon">This Week at a Glance</div>
        <hr class="rule" />
        <GlanceList items={entry.data.glance} />
      </section>
    )}

    {entry.data.scorecard.length > 0 && (
      <section class="ed__section">
        <div class="ribbon">Regulatory Scorecard</div>
        <hr class="rule" />
        <ScorecardTable rows={entry.data.scorecard} />
      </section>
    )}

    <Content components={{ ImplicationBox }} />

    <hr class="rule-hard" style="margin-top: 40px;" />
    <div class="ed__end">
      <span class="pill">End of edition</span>
      <span class="ed__end-meta">· Gus</span>
    </div>

  </article>
</BaseLayout>
