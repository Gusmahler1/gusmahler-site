---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const allIssues = await getCollection('issues');
const recentIssues = allIssues
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);
---

<BaseLayout
  title="Gus Mahler"
  description="Personal site of Gus Mahler — writer on prediction markets, regulation, and political theory."
>
  <div class="home-port">
    <div class="home-port__grid">

      <aside class="home-port__bio">
        <div class="home-port__monogram">GM</div>
        <h1 class="home-port__name">Gus Mahler</h1>
        <p class="home-port__lead">I write essays on political theory and a weekly newsletter on the regulatory fight over prediction markets. On the side I run regressions on whatever I'm curious about and post the results.</p>
        <p class="home-port__lead">Based in New York. The site is a place to keep the work in one place.</p>
        <div class="home-port__nav">
          <a href="/newsletter">Read the newsletter →</a>
          <a href="/writing">Read the writing →</a>
          <a href="/projects">Browse the projects →</a>
          <a href="/about">About →</a>
        </div>
      </aside>

      <div class="home-port__work">

        <!-- Newsletter -->
        <section class="home-port__group">
          <header class="home-port__group-head">
            <div class="ribbon">Newsletter</div>
            <a class="home-port__group-see" href="/newsletter">All →</a>
          </header>
          <ul class="home-port__list">
            {recentIssues.map((issue) => {
              const kicker = issue.data.date.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
                timeZone: 'UTC',
              });
              return (
                <li class="home-port__row">
                  <a class="home-port__link" href={`/newsletter/${issue.id}`}>
                    <div class="kicker">{kicker}</div>
                    <h3 class="home-port__title">{issue.data.title}</h3>
                    {issue.data.preview && <p class="home-port__deck">{issue.data.preview}</p>}
                  </a>
                </li>
              );
            })}
          </ul>
        </section>

        <!-- Writing -->
        <section class="home-port__group">
          <header class="home-port__group-head">
            <div class="ribbon">Writing</div>
            <a class="home-port__group-see" href="/writing">All →</a>
          </header>
          <ul class="home-port__list">
            <li class="home-port__row">
              <div class="home-port__link">
                <p class="home-port__deck">Essays and long-form pieces coming soon.</p>
              </div>
            </li>
          </ul>
        </section>

        <!-- Projects -->
        <section class="home-port__group">
          <header class="home-port__group-head">
            <div class="ribbon">Projects</div>
            <a class="home-port__group-see" href="/projects">All →</a>
          </header>
          <ul class="home-port__list">
            <li class="home-port__row">
              <div class="home-port__link">
                <p class="home-port__deck">Side projects coming soon.</p>
              </div>
            </li>
          </ul>
        </section>

      </div>
    </div>
  </div>
</BaseLayout>
