---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const essays = (await getCollection('essays')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    timeZone: 'UTC',
  });
}

function readTime(description: string | undefined) {
  // Rough proxy — not word-counting full MDX here, just show "Long read"
  return 'Long read';
}
---

<BaseLayout
  title="Thoughts and Research · Gus Mahler"
  description="Research notes, regression projects, and shorter essays by Gus Mahler."
>
  <div class="page-essays">
    <div class="page-head" style="padding-left: 28px; padding-right: 28px;">
      <div class="kicker-bold">Thoughts &amp; Research · By Gus Mahler</div>
      <h1 class="page-head__title">Thoughts &amp; Research</h1>
      <p class="page-head__deck">Regressions, research notes, and essays on politics, economics, and American political thought.</p>
    </div>

    <hr class="rule-hard" style="max-width: 1100px; margin: 0 auto 0;" />

    <div style="max-width: 1100px; margin: 0 auto; padding: 40px 28px 0;">
      <h2 class="nl__subnav-link" style="display: inline-block; border-bottom: 2px solid #000; padding-bottom: 8px; margin-bottom: 0; cursor: default; text-decoration: none;">Academic essays on liberalism written without AI</h2>
    </div>

    <ul class="essay-list" style="margin-top: 0;">
      {essays.map((essay) => (
        <li class="essay-row">
          <a href={`/writing/${essay.id}`} class="essay-row__link">
            <div>
              <h2 class="essay-row__title">{essay.data.title}</h2>
              {essay.data.description && (
                <p class="essay-row__deck">{essay.data.description}</p>
              )}
            </div>
            <div class="essay-row__right">
              <span class="essay-row__time">{formatDate(essay.data.date)}</span>
              <span class="essay-row__read">Read →</span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
