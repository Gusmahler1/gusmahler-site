---
interface Row {
  front: string;
  status: 'favorable' | 'neutral' | 'hostile';
  note: string;
}

interface Props {
  rows: Row[];
}

const { rows } = Astro.props;
---

{rows.length > 0 && (
  <table class="score">
    <thead>
      <tr>
        <th>Front</th>
        <th>Status</th>
        <th>Note</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr>
          <td class="score__front">{row.front}</td>
          <td>
            <span class={`pmw-status pmw-status--${row.status}`}>
              {row.status.toUpperCase()}
            </span>
          </td>
          <td>{row.note}</td>
        </tr>
      ))}
    </tbody>
  </table>
)}
