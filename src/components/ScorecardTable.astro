---
interface Row {
  front: string;
  status: 'favorable' | 'neutral' | 'hostile';
  note: string;
}

interface Props {
  rows: Row[];
}

const { rows } = Astro.props;

const STATUS_LABEL: Record<Row['status'], string> = {
  favorable: 'FAVORABLE',
  neutral: 'NEUTRAL',
  hostile: 'HOSTILE',
};
---

{rows.length > 0 && (
  <div class="state-of-market">
    <h2 class="state-heading">State of the Market</h2>
    <p class="section-label">Regulatory Scorecard</p>
    <table class="scorecard-table">
      <thead>
        <tr>
          <th style="width:22%">Front</th>
          <th style="width:20%">Status</th>
          <th>Note</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr>
            <td class="scorecard-front">{row.front}</td>
            <td>
              <span class={`status-badge status-${row.status}`}>
                {STATUS_LABEL[row.status]}
              </span>
            </td>
            <td class="scorecard-note">{row.note}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
)}

<style>
  .state-of-market {
    background: #f7f7f7;
    border: 1px solid #ddd;
    padding: 20px 24px;
    margin-top: 32px;
    border-radius: 4px;
  }

  .state-heading {
    font-size: 1.05rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #444;
    margin-top: 0;
    margin-bottom: 12px;
    border-bottom: 1px solid #ccc;
    padding-bottom: 4px;
  }

  .section-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: #888;
    margin: 0 0 8px;
  }

  .scorecard-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
    margin-bottom: 4px;
  }

  .scorecard-table th {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #888;
    font-weight: normal;
    text-align: left;
    padding: 4px 8px 8px 0;
    border-bottom: 1px solid #e0e0e0;
  }

  .scorecard-table td {
    padding: 8px 8px 8px 0;
    border-bottom: 1px solid #f0f0f0;
    vertical-align: top;
  }

  .scorecard-table tr:last-child td {
    border-bottom: none;
  }

  .scorecard-front {
    font-weight: bold;
    color: #222;
    white-space: nowrap;
  }

  .scorecard-note {
    font-size: 0.8rem;
    color: #666;
    font-style: italic;
  }

  .status-badge {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: bold;
    padding: 2px 7px;
    border-radius: 3px;
    white-space: nowrap;
  }

  .status-favorable {
    background: #e8f8ec;
    color: #1a7a3a;
  }

  .status-neutral {
    background: #f4f4f4;
    color: #555;
  }

  .status-hostile {
    background: #fde8e8;
    color: #c0392b;
  }
</style>
