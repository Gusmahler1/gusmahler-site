---
interface Props {
  items: string[];
}

const { items } = Astro.props;
---

{items.length > 0 && (
  <ul class="glance">
    {items.map((item, i) => (
      <li class="glance__item">
        <span class="glance__num">{String(i + 1).padStart(2, '0')}</span>
        <span class="glance__text">{item}</span>
      </li>
    ))}
  </ul>
)}
