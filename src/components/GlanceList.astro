---
interface Props {
  items: string[];
}

const { items } = Astro.props;
---

{items.length > 0 && (
  <>
    <h2>This Week at a Glance</h2>
    <ul class="glance-list">
      {items.map((item) => <li>{item}</li>)}
    </ul>
  </>
)}

<style>
  h2 {
    font-size: 1.05rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #444;
    margin-top: 40px;
    margin-bottom: 12px;
    border-bottom: 1px solid #ddd;
    padding-bottom: 4px;
  }

  .glance-list {
    margin: 0;
    padding-left: 20px;
  }

  .glance-list li {
    margin: 4px 0;
    font-size: 0.95rem;
  }
</style>
